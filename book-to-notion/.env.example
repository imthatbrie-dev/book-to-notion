# --- Notion public OAuth integration ---
# Create at https://www.notion.so/my-integrations  ->  "New integration"
# choose type "Public", and copy these from the integration's settings.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Must EXACTLY match the Redirect URI you set on the Notion integration.
# Local dev:   http://localhost:3000/api/auth/callback
# Production:  https://YOUR-APP.vercel.app/api/auth/callback
# If you leave this blank, the app derives it from the incoming request origin,
# which works on Vercel — but setting it explicitly is recommended.
NOTION_REDIRECT_URI=

# --- Session encryption ---
# Any random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
